# Shared local defaults
POSTGRES_DB=braintek
POSTGRES_USER=braintek
POSTGRES_PASSWORD=braintek_dev_password

# CMS
HOST=0.0.0.0
PORT=1337
APP_KEYS=replace-me-1,replace-me-2,replace-me-3,replace-me-4
API_TOKEN_SALT=replace-me
ADMIN_JWT_SECRET=replace-me
TRANSFER_TOKEN_SALT=replace-me
JWT_SECRET=replace-me
DATABASE_CLIENT=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=braintek
DATABASE_USERNAME=braintek
DATABASE_PASSWORD=braintek_dev_password
DATABASE_SSL=false
PUBLIC_URL=http://localhost:1337
FRONTEND_URL=http://localhost:3000
PREVIEW_SECRET=replace-with-a-long-random-preview-secret
SEED_DEMO_CONTENT=true
INQUIRY_NOTIFICATION_EMAIL=info@braintek.ae
EMAIL_DEFAULT_FROM=BRAINTEK <no-reply@braintek.ae>
EMAIL_DEFAULT_REPLY_TO=info@braintek.ae
# Production SMTP (leave SMTP_HOST empty for local sendmail fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=

# Web
STRAPI_API_TOKEN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
STRAPI_URL=http://cms:1337
NEXT_PUBLIC_INQUIRY_ENDPOINT=http://localhost:1337/api/inquiries

# Optional production object storage (S3 or S3-compatible). Leave S3_BUCKET empty locally.
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_ACCESS_SECRET=
S3_ENDPOINT=
CDN_URL=
