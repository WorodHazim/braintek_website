{
  "kind": "collectionType",
  "collectionName": "media_assets",
  "info": {
    "singularName": "media-asset",
    "pluralName": "media-assets",
    "displayName": "Media Asset"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "file": {
      "type": "media",
      "multiple": false
    },
    "alt_text": {
      "type": "string"
    },
    "media_type": {
      "type": "string"
    },
    "focal_point": {
      "type": "json"
    },
    "usage_context": {
      "type": "string"
    },
    "credit": {
      "type": "string"
    },
    "workflow_status": {
      "type": "enumeration",
      "enum": [
        "draft",
        "review",
        "published",
        "archived"
      ],
      "default": "draft"
    }
  }
}