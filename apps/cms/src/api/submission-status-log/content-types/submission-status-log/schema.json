    },
    "previous_status": {
      "type": "string"
    },
    "new_status": {
      "type": "string",
      "required": true
    },
    "changed_by": {
      "type": "string"
    },
    "note": {
      "type": "text"
    },
    "changed_at": {
      "type": "datetime",
      "required": true
    },
    "submission": {
      "type": "relation",
