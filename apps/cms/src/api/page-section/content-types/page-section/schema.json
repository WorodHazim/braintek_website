{
  "kind": "collectionType",
  "collectionName": "page_sections",
  "info": {
    "singularName": "page-section",
    "pluralName": "page-sections",
    "displayName": "Page Section"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "section_type": {
      "type": "string",
      "required": true
    },
    "eyebrow": {
      "type": "string"
    },
    "heading": {
      "type": "string"
    },
    "body": {
      "type": "richtext"
    },
    "payload": {
      "type": "json"
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    },
    "workflow_status": {
      "type": "enumeration",
      "enum": [
        "draft",
        "review",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "page": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::page.page",
      "inversedBy": "sections"
    }
  }
}
